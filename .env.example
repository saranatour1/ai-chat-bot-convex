# Generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# The following keys below are automatically created and
# added to your environment when you deploy on vercel

# Google Gemini API key for AI SDK provider.
# Create one in Google AI Studio and set it for both Next.js and Convex runtimes.
GOOGLE_GENERATIVE_AI_API_KEY=****

# Optional model overrides (defaults are stable Gemini models in code).
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_REASONING_MODEL=gemini-2.5-pro
GEMINI_TITLE_MODEL=gemini-2.5-flash-lite
GEMINI_ARTIFACT_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Optional Convex Agent model override.
CONVEX_AGENT_MODEL=gemini-2.5-flash

# Instructions to create a Vercel Blob Store here: https://vercel.com/docs/storage/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# Instructions to create a PostgreSQL database here: https://vercel.com/docs/storage/vercel-postgres/quickstart
POSTGRES_URL=****


# Instructions to create a Redis store here:
# https://vercel.com/docs/redis
REDIS_URL=****
